{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "whitespace", "--folder", "--verify-no-changes", "--include", "${staged}" ],
         "include": [ "**/*.cs" ]
      },
      {
         "name": "build",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "build", "--nologo", "-v", "q", "--artifacts-path", "artifacts/pre-commit" ]
      },
      {
         "name": "test",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "test", "--no-build", "--no-progress", "--no-ansi", "--artifacts-path", "artifacts/pre-commit" ]
      }
   ]
}
