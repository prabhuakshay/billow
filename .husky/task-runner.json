{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "format",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "format", "whitespace", "--folder", "--verify-no-changes", "--include", "${staged}" ],
         "include": [ "**/*.cs" ]
      },
      {
         "name": "build",
         "group": "pre-commit",
         "command": "dotnet",
         "args": [ "build", "src/Billow/Billow.csproj", "--nologo", "-v", "q", "-o", "artifacts/pre-commit" ]
      }
   ]
}
