<Window x:Class="Billow.Customers.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Billow.Customers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:CustomerViewModel}"
        Title="{Binding Title}" Width="480" Height="600" MinWidth="380" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2,3" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Save" IsDefault="True" Width="80" Height="24"
                        Command="{Binding SaveCommand}" />
                <Button Content="Cancel" Width="80" Height="24" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <Border BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,8,16,16">
                    <Label Content="_Name (required)" Target="{Binding ElementName=NameBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ContentControl Style="{StaticResource WithError}">
                        <TextBox x:Name="NameBox"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </ContentControl>

                    <Label Content="Address Line _1" Target="{Binding ElementName=AddressLine1Box}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AddressLine1Box"
                             Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="Address Line _2" Target="{Binding ElementName=AddressLine2Box}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AddressLine2Box"
                             Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="_City" Target="{Binding ElementName=CityBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CityBox"
                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="St_ate" Target="{Binding ElementName=StateBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="StateBox" ItemsSource="{Binding States}"
                              SelectedItem="{Binding State}" />

                    <Label Content="_PIN" Target="{Binding ElementName=PinBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ContentControl Style="{StaticResource WithError}">
                        <TextBox x:Name="PinBox" Width="100" HorizontalAlignment="Left"
                                 Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" />
                    </ContentControl>

                    <Label Content="Ph_one" Target="{Binding ElementName=PhoneBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ContentControl Style="{StaticResource WithError}">
                        <TextBox x:Name="PhoneBox" Width="200" HorizontalAlignment="Left"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    </ContentControl>

                    <Label Content="_Email" Target="{Binding ElementName=EmailBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ContentControl Style="{StaticResource WithError}">
                        <TextBox x:Name="EmailBox"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
