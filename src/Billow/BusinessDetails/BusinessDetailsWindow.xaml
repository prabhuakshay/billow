<Window x:Class="Billow.BusinessDetails.BusinessDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Billow.BusinessDetails"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:BusinessDetailsViewModel}"
        Title="Business Details" Width="560" Height="640" MinWidth="420" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2,3" />
            <Style.Triggers>
                <!-- Look different from a box that can be typed in. -->
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The error under a field. Takes no space while the field has no error. -->
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C42B1C" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Save" IsDefault="True" Width="80" Height="24"
                        Command="{Binding SaveCommand}" />
                <Button Content="Cancel" Width="80" Height="24" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>

        <Border BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,0,16,16">
                    <TextBlock Text="Identity" Style="{StaticResource SectionHeading}" />

                    <Label Content="_Legal Name (required)" Target="{Binding ElementName=LegalNameBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LegalNameBox"
                             Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=LegalNameBox}" />

                    <Label Content="_Trade Name" Target="{Binding ElementName=TradeNameBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TradeNameBox"
                             Text="{Binding TradeName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Address" Style="{StaticResource SectionHeading}" />

                    <Label Content="Line _1 (required)" Target="{Binding ElementName=AddressLine1Box}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AddressLine1Box"
                             Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=AddressLine1Box}" />

                    <Label Content="Line _2" Target="{Binding ElementName=AddressLine2Box}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AddressLine2Box"
                             Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Content="_City (required)" Target="{Binding ElementName=CityBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CityBox"
                             Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=CityBox}" />

                    <Label Content="St_ate (required)" Target="{Binding ElementName=StateBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="StateBox" ItemsSource="{Binding States}"
                              SelectedItem="{Binding State}">
                        <ComboBox.Style>
                            <!-- Locked while it is filled in from a valid GSTIN. -->
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AreStateAndPanLocked}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=StateBox}" />

                    <Label Content="_PIN (required)" Target="{Binding ElementName=PinBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PinBox" Width="100" HorizontalAlignment="Left"
                             Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=PinBox}" />

                    <TextBlock Text="GST" Style="{StaticResource SectionHeading}" />

                    <Label Content="_Registration Type (required)" Target="{Binding ElementName=RegistrationTypeBox}"
                           Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="RegistrationTypeBox" Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding RegistrationTypes}"
                              SelectedItem="{Binding RegistrationType}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=RegistrationTypeBox}" />

                    <!-- Only a Regular or Composition Business has a GSTIN. -->
                    <StackPanel Visibility="{Binding IsGstinApplicable, Converter={StaticResource BooleanToVisibility}}">
                        <Label Content="_GSTIN (required)" Target="{Binding ElementName=GstinBox}"
                               Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="GstinBox" Width="200" HorizontalAlignment="Left"
                                 CharacterCasing="Upper"
                                 Text="{Binding Gstin, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldError}"
                                   Text="{Binding (Validation.Errors)/ErrorContent, ElementName=GstinBox}" />
                    </StackPanel>

                    <Label Content="PA_N" Target="{Binding ElementName=PanBox}"
                           Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PanBox" Width="160" HorizontalAlignment="Left"
                             CharacterCasing="Upper"
                             IsReadOnly="{Binding AreStateAndPanLocked}"
                             Text="{Binding Pan, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldError}"
                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=PanBox}" />

                    <TextBlock Text="Additional Registrations" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Printed on Bills in this order, such as an FSSAI licence or a Drug Licence."
                               TextWrapping="Wrap" />

                    <ItemsControl x:Name="AdditionalRegistrationsList" Focusable="False"
                                  ItemsSource="{Binding AdditionalRegistrations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Suggests the common labels. Any other text may be typed, so it doesn't auto-complete. -->
                                    <ComboBox x:Name="LabelBox" IsEditable="True" IsTextSearchEnabled="False"
                                              AutomationProperties.Name="Label"
                                              ItemsSource="{Binding DataContext.SuggestedAdditionalRegistrationLabels,
                                                                    ElementName=AdditionalRegistrationsList}"
                                              Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="NumberBox" Grid.Column="1" Margin="6,0,0,0"
                                             AutomationProperties.Name="Number"
                                             Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button Content="▲" Width="24" ToolTip="Move up"
                                                AutomationProperties.Name="Move up"
                                                Command="{Binding MoveUpCommand}" />
                                        <Button Content="▼" Width="24" Margin="2,0,0,0" ToolTip="Move down"
                                                AutomationProperties.Name="Move down"
                                                Command="{Binding MoveDownCommand}" />
                                        <Button Content="Remove" Padding="6,0" Margin="6,0,0,0"
                                                Command="{Binding RemoveCommand}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldError}"
                                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=LabelBox}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="6,2,0,0"
                                               Style="{StaticResource FieldError}"
                                               Text="{Binding (Validation.Errors)/ErrorContent, ElementName=NumberBox}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="A_dd Additional Registration" HorizontalAlignment="Left" Padding="10,2" Margin="0,8,0,0"
                            Command="{Binding AddAdditionalRegistrationCommand}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
